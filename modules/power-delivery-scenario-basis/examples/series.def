VERSION 5.8 ;
DIVIDERCHAR "/" ; BUSBITCHARS "[]" ; DESIGN owned_supply ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 40000 12000 ) ;
COMPONENTS 2 ;
- load0 LOAD + PLACED ( 10000 5000 ) N ;
- load1 LOAD + PLACED ( 20000 5000 ) N ;
END COMPONENTS
PINS 2 ;
- VDD + NET VDD + DIRECTION INOUT + USE POWER + PORT + LAYER metal1 ( -100 -100 ) ( 100 100 ) + FIXED ( 500 5500 ) N ;
- VSS + NET VSS + DIRECTION INOUT + USE GROUND + PORT + LAYER metal1 ( -100 -100 ) ( 100 100 ) + FIXED ( 500 5150 ) N ;
END PINS
SPECIALNETS 2 ;
- VDD ( PIN VDD ) ( load0 VDD ) ( load1 VDD ) + USE POWER + ROUTED metal1 400 ( 500 5500 ) ( 30000 5500 ) ;
- VSS ( PIN VSS ) ( load0 VSS ) ( load1 VSS ) + USE GROUND + ROUTED metal1 200 ( 500 5150 ) ( 30000 5150 ) ;
END SPECIALNETS
END DESIGN
