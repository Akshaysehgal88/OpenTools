{
  "format": "opentools.module.v1",
  "id": "side-effect-access-order",
  "title": "Side-effect and access-order review",
  "description": "Review register side effects, caller intent and selected diagnostic evidence across destructive reads and recovery.",
  "stages": [
    "design",
    "integration-verification",
    "firmware",
    "bring-up evidence interpretation"
  ],
  "workflow": "SKILL.md",
  "helpers": [
    {
      "path": "access_review.py",
      "purpose": "Review accepted quiescent register accesses and per-access intent.",
      "requirements": [
        "Python 3.10+ standard library"
      ]
    },
    {
      "path": "rdl_effects.py",
      "purpose": "Capture effective properties of selected ordinary SystemRDL registers.",
      "requirements": [
        "Python 3.10+",
        "systemrdl-compiler==1.32.2 (optional)"
      ]
    },
    {
      "path": "profiles/diagnostic-validity/diagnostic_review.py",
      "purpose": "Review a selected diagnostic observation and saved capture against independent cause/epoch/consumer requirements.",
      "requirements": [
        "Python 3.10+ standard library"
      ]
    },
    {
      "path": "profiles/bringup-observation/bringup_review.py",
      "purpose": "Compare retained diagnostic receipts with independent device,image,reset and source-time expectations.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved device-emulation corpus and original observation question"
      ]
    }
  ],
  "files": [
    "README.md",
    "FORMAT.md",
    "SKILL.md",
    "AI_USAGE.md",
