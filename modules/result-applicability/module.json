{
  "format": "opentools.module.v1",
  "id": "result-applicability",
  "title": "Result applicability",
  "description": "Establish whether saved evidence covers the requested build, scope and claim, including formal premises and equivalence/ECO boundaries.",
  "stages": [
    "verification",
    "formal",
    "integration",
    "handoff",
    "STA scenario planning",
    "STA interface budget handoff",
    "erratum/workaround maintenance"
  ],
  "workflow": "SKILL.md",
  "helpers": [
    {
      "path": "applicability_check.py",
      "purpose": "Inspect qualified SiliconCompiler JSON and compare bounded result correspondence.",
      "requirements": [
        "Python 3.10+; SiliconCompiler is not required for reading saved JSON"
      ]
    },
    {
      "path": "profiles/formal-assumptions/formal_review.py",
      "purpose": "Read qualified saved SBY evidence and review one property's premises, producer support and required activation.",
      "requirements": [
        "Python 3.10+; native tools are not required for saved-data review"
      ]
    },
    {
      "path": "profiles/equivalence-boundary/equivalence_review.py",
      "purpose": "Read qualified saved Yosys equivalence evidence and review ECO, point-map and mode applicability.",
      "requirements": [
        "Python 3.10+; native tools are not required for saved-data review"
      ]
    },
    {
      "path": "profiles/eco-evidence/eco_review.py",
      "purpose": "Review a bounded physical ECO, selected report dependencies and supplied evidence reuse conditions.",
      "requirements": [
        "Python 3.10+ for saved-data review; native example collection has separately configured tools"
      ]
    },
    {
      "path": "profiles/timing-scenarios/scenario_review.py",
      "purpose": "Reconcile independent timing-scenario obligations with qualified native model/mode/clock/RC evidence and preserve original timing outcomes.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved OpenROAD scenario corpus and original applicability/requirements sources"
      ]
    },
    {
      "path": "profiles/interface-budget/budget_review.py",
      "purpose": "Review original block/top timing allocations against native reference edges, models, loads, mapped cones and selected paths.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved three-view native corpus and original interface budget sources"
      ]
    },
    {
      "path": "profiles/erratum-workaround/erratum_review.py",
      "purpose": "Review supplied erratum conditions, selected workaround efficacy, dependent premises and current approval correspondence.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved owned-model evidence and independent notice/approval sources"
      ]
    }
  ],
