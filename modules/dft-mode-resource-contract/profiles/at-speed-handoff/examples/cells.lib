/* Owned ideal fixture setup/hold numbers; not characterized timing. */
library (owned_scan) {
delay_model : table_lookup;
input_threshold_pct_rise : 50;
input_threshold_pct_fall : 50;
output_threshold_pct_rise : 50;
output_threshold_pct_fall : 50;
slew_lower_threshold_pct_rise : 20;
slew_lower_threshold_pct_fall : 20;
slew_upper_threshold_pct_rise : 80;
slew_upper_threshold_pct_fall : 80;
time_unit : "1ns";
voltage_unit : "1V";
current_unit : "1mA";
pulling_resistance_unit : "1kohm";
capacitive_load_unit (1,pf);
nom_voltage : 1; nom_process : 1; nom_temperature : 25;
cell (DFFR_CELL) {
area : 1;
ff (IQ,IQN) { clocked_on : "CK"; clear : "!RN"; next_state : "D"; }
pin (CK) { direction : input; capacitance : 0.001; clock : true; }
pin (RN) { direction : input; capacitance : 0.001; }
pin (D) { direction : input; capacitance : 0.001;
  timing () { related_pin : "CK"; timing_type : setup_rising;
    rise_constraint (scalar) { values ("0.02"); }
    fall_constraint (scalar) { values ("0.02"); }
  }
  timing () { related_pin : "CK"; timing_type : hold_rising;
    rise_constraint (scalar) { values ("0.01"); }
    fall_constraint (scalar) { values ("0.01"); }
  }
}
pin (Q) { direction : output; function : "IQ"; timing () { related_pin : "CK"; timing_type : rising_edge; timing_sense : non_unate; cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } timing () { related_pin : "RN"; timing_type : clear; timing_sense : positive_unate; cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } }
}
cell (SCANR_CELL) {
area : 2;
ff (IQ,IQN) { clocked_on : "CK"; clear : "!RN"; next_state : "(D & !SE) | (SI & SE)"; }
pin (CK) { direction : input; capacitance : 0.001; clock : true; }
pin (RN) { direction : input; capacitance : 0.001; }
pin (D) { direction : input; capacitance : 0.001;
  timing () { related_pin : "CK"; timing_type : setup_rising;
    rise_constraint (scalar) { values ("0.02"); }
    fall_constraint (scalar) { values ("0.02"); }
  }
  timing () { related_pin : "CK"; timing_type : hold_rising;
    rise_constraint (scalar) { values ("0.01"); }
    fall_constraint (scalar) { values ("0.01"); }
  }
}
pin (SI) { direction : input; capacitance : 0.001; }
pin (SE) { direction : input; capacitance : 0.001; }
pin (Q) { direction : output; function : "IQ"; timing () { related_pin : "CK"; timing_type : rising_edge; timing_sense : non_unate; cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } timing () { related_pin : "RN"; timing_type : clear; timing_sense : positive_unate; cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); } rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); } } }
test_cell () {
ff (IQ,IQN) { clocked_on : "CK"; clear : "!RN"; next_state : "D"; }
pin (CK) { direction : input; }
pin (RN) { direction : input; }
pin (D) { direction : input; }
pin (SI) { direction : input; signal_type : "test_scan_in"; }
pin (SE) { direction : input; signal_type : "test_scan_enable"; }
pin (Q) { direction : output; function : "IQ"; signal_type : "test_scan_out"; }
}
}
cell (AND_CELL) {
area : 1;
pin (A) { direction : input; capacitance : 0.001; }
pin (B) { direction : input; capacitance : 0.001; }
pin (Y) { direction : output; function : "A & B";
timing () { related_pin : "A"; timing_sense : positive_unate;
cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); }
rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); }
}
timing () { related_pin : "B"; timing_sense : positive_unate;
cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); }
rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); }
}
}
}
cell (INV_CELL) {
area : 1;
pin (A) { direction : input; capacitance : 0.001; }
pin (Y) { direction : output; function : "!A";
timing () { related_pin : "A"; timing_sense : negative_unate;
cell_rise (scalar) { values ("0.01"); } cell_fall (scalar) { values ("0.01"); }
rise_transition (scalar) { values ("0.01"); } fall_transition (scalar) { values ("0.01"); }
} }
}
}
