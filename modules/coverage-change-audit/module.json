{
  "format": "opentools.module.v1",
  "id": "coverage-change-audit",
  "title": "Coverage change audit",
  "description": "Distinguish newly exercised behavior from changes to coverage definitions, options and denominator.",
  "stages": [
    "functional-verification",
    "coverage",
    "dft"
  ],
  "workflow": "SKILL.md",
  "helpers": [
    {
      "path": "coverage_audit.py",
      "purpose": "Compare qualified normalized coverage records and reviewed correspondence.",
      "requirements": [
        "Python 3.10+"
      ]
    },
    {
      "path": "ucis_import.py",
      "purpose": "Read the qualified native UCIS XML profile with explicit semantic context.",
      "requirements": [
        "Python 3.10+",
        "requirements-ucis.txt; see FORMAT.md"
      ]
    },
    {
      "path": "profiles/fault-denominator/fault_audit.py",
      "purpose": "Review owned native original/collapsed fault populations, classifications and reported denominator changes.",
      "requirements": [
        "Python 3.10+ standard library; saved owned Verilator5.020 records"
      ]
    }
  ],
  "files": [
    "AI_USAGE.md",
    "FORMAT.md",
    "README.md",
    "SKILL.md",
    "coverage_audit.py",
    "coverage_core.py",
    "example.json",
    "examples/create_example.py",
    "record.template.json",
    "requirements-ucis.txt",
    "tests/test_coverage.py",
    "ucis_import.py",
    "profiles/fault-denominator/FORMAT.md",
    "profiles/fault-denominator/README.md",
    "profiles/fault-denominator/WORKFLOW.md",
    "profiles/fault-denominator/examples/create_example.py",
    "profiles/fault-denominator/examples/fault_network.sv",
    "profiles/fault-denominator/examples/fixture.py",
    "profiles/fault-denominator/examples/main.cpp",
    "profiles/fault-denominator/examples/reference_model.py",
    "profiles/fault-denominator/examples/run_native.py",
    "profiles/fault-denominator/fault_audit.py",
    "profiles/fault-denominator/fault_common.py",
    "profiles/fault-denominator/fault_core.py",
    "profiles/fault-denominator/native_fault.py",
    "profiles/fault-denominator/review-record.json",
    "profiles/fault-denominator/tests/test_faults.py",
    "adoption.json"
  ],
  "adoption": "adoption.json"
}
