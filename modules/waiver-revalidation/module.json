{
  "format": "opentools.module.v1",
  "id": "waiver-revalidation",
  "title": "Waiver revalidation",
  "description": "Investigate whether a recorded waiver still applies to the current findings, premises and configuration.",
  "stages": [
    "design",
    "verification",
    "lint",
    "DFT scan insertion and closure",
    "STA exception closure"
  ],
  "workflow": "SKILL.md",
  "helpers": [
    {
      "path": "waiver_revalidate.py",
      "purpose": "Compare supported saved waiver populations and explicit premises.",
      "requirements": [
        "Python 3.10+"
      ]
    },
    {
      "path": "verilator_capture.py",
      "purpose": "Capture the qualified native Verilator waiver profile.",
      "requirements": [
        "Python 3.10+",
        "Verilator 5.020; see FORMAT.md"
      ]
    },
    {
      "path": "waiver_assist.py",
      "purpose": "Prepare facts and check AI review binding/structure without verifying prose.",
      "requirements": [
        "Python 3.10+"
      ]
    },
    {
      "path": "profiles/crossing-premises/crossing_capture.py",
      "purpose": "Add source-stability and reset-readiness observations to selected crossing waiver snapshots.",
      "requirements": [
        "Python 3.10+ standard library; explicit normalized population and bound settled-event journal"
      ]
    },
    {
      "path": "profiles/scan-population/scan_population.py",
      "purpose": "Review independent required state against native scan membership and current exclusions; compare selected exclusion drift.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved OpenROAD inventory and explicit independent state/exclusion sources"
      ]
    },
    {
      "path": "profiles/timing-exception/sta_exception.py",
      "purpose": "Review native setup false-path endpoint reach against independent intent, mode/clock premises and reviewed correspondence.",
      "requirements": [
        "Python 3.10+ standard library; qualified saved OpenROAD setup-exception archive and original rationale/intent"
      ]
    }
  ],
  "files": [
