{
  "format": "opentools.module.v1",
  "id": "integration-interface-obligations",
  "title": "Integration interface obligations",
  "description": "Review endpoint meanings and transient ownership/completion obligations using connected ports, source contracts and native events.",
  "stages": [
    "design",
    "integration-verification",
    "functional-verification"
  ],
  "workflow": "SKILL.md",
  "helpers": [
    {
      "path": "port_capture.py",
      "purpose": "Capture selected native direct port bindings while leaving protocol meaning to source/native review.",
      "requirements": [
        "Python 3.11+",
        "pyslang 12.0.0"
      ]
    },
    {
      "path": "profiles/transition-obligations/transition_review.py",
      "purpose": "Review one identity/epoch-tagged exclusive handoff, distinct-source obligations and actual grant/consumer permission.",
      "requirements": [
        "Python 3.10+ standard library"
      ]
    }
  ],
  "files": [
    "README.md",
