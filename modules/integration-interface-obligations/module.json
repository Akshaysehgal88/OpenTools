    "examples/NATIVE.md",
    "tests/test_ports.py",
    "profiles/transition-obligations/README.md",
    "profiles/transition-obligations/FORMAT.md",
    "profiles/transition-obligations/WORKFLOW.md",
    "profiles/transition-obligations/AI_USAGE.md",
    "profiles/transition-obligations/transition_core.py",
    "profiles/transition-obligations/transition_review.py",
    "profiles/transition-obligations/examples/create_example.py",
    "profiles/transition-obligations/examples/reference_model.py",
    "profiles/transition-obligations/examples/ownership_transfer.sv",
    "profiles/transition-obligations/examples/run_native.py",
    "profiles/transition-obligations/examples/NATIVE.md",
    "profiles/transition-obligations/tests/test_transition.py",
    "adoption.json"
  ],
  "adoption": "adoption.json"
}
